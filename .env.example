# ==============================================================================
# TrailMate Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
#
# IMPORTANT PRODUCTION SAFETY RULES:
# 1. In production, SECRET_KEY must be a strong, non-placeholder random key.
#    Generate one via: python -c "import secrets; print(secrets.token_hex(32))"
# 2. In production, ADMIN_EMAIL and a secure ADMIN_PASSWORD (min 8 chars) are
#    STRICTLY REQUIRED when running `flask init-db`. Default passwords like
#    "admin123" are blocked and will cause provisioning to fail.
# ==============================================================================

# Flask Environment & Core Settings
FLASK_APP=wsgi.py
FLASK_DEBUG=0
# FLASK_ENV=production

# Security: Mandatory in production.
# In local development, an automatic dev fallback is used if left blank.
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Connection
# When unset, defaults to local SQLite: instance/trekking.db
# For PostgreSQL (production or local Docker):
# DATABASE_URL=postgresql://user:password@localhost:5432/trailmate_db

# Initial Administrator Provisioning (Required when running `flask init-db` in production)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@trailmate.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Server Runtime Settings
PORT=5000
# SESSION_COOKIE_SECURE=true  # Set to true when serving over HTTPS

# Razorpay Test-Mode (do NOT commit real keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxx
RAZORPAY_KEY_SECRET=XXXXXXXXXXX

# Cloudinary (optional; leave empty to use local fallback images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment configuration
PAYMENT_CURRENCY=INR
# Minutes before a pending payment is considered abandoned for reconciliation
PAYMENT_PENDING_EXPIRY_MINUTES=15

