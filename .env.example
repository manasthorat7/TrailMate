# ==============================================================================
# TrailMate Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
#
# IMPORTANT PRODUCTION SAFETY RULES:
# 1. In production, SECRET_KEY must be a strong, non-placeholder random key
#    (at least 16 characters).
#    Generate one via: python -c "import secrets; print(secrets.token_hex(32))"
# 2. In production, DATABASE_URL must point at a shared PostgreSQL database.
#    A missing or SQLite DATABASE_URL causes startup to fail on purpose.
# 3. In production, ADMIN_EMAIL and a secure ADMIN_PASSWORD (min 8 chars, not a
#    documented placeholder) are STRICTLY REQUIRED when running `flask init-db`.
#    Default or example passwords are blocked and will cause provisioning to fail.
# ==============================================================================

# Flask Environment & Core Settings
FLASK_APP=wsgi.py
# Local development keeps debug on. Production ignores this and uses Gunicorn.
FLASK_DEBUG=1
# Production mode indicator (Render sets ENV=production; do not enable locally)
# ENV=production

# Security: Mandatory in production.
# In local development, an automatic dev fallback is used if left blank.
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Connection
# Local development: leave DATABASE_URL unset to use instance/trekking.db.
# Production (Render): set the internal PostgreSQL connection string. SQLite is rejected.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Initial Administrator Provisioning (required only for `flask init-db` on a fresh database)
# Remove ADMIN_PASSWORD from the environment after provisioning if you prefer.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Server Runtime Settings
# Render supplies PORT automatically; do not hardcode it there.
PORT=5000
# SESSION_COOKIE_SECURE=true  # Forced automatically in production

# Razorpay Test-Mode (do NOT commit real keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (optional; leave empty to use local fallback images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment configuration
PAYMENT_CURRENCY=INR
# Minutes before a pending payment is considered abandoned for reconciliation
PAYMENT_PENDING_EXPIRY_MINUTES=15

